<div class="js-pp-container pp-container" data-context="{{ pagepartadmin.context }}" data-pageid="{{ pagepartadmin.page.id }}" data-pageclassname="{{ pagepartadmin.getClassName(pagepartadmin.page) }}">
    {% set ppTypes = pagepartadmin.possiblePagePartTypes %}
    {% if ppTypes | length > 0 %}
        <!-- First New PP select -->
        {% include '@KunstmaanPagePart/PagePartAdminTwigExtension/add_pagepart.html.twig' with {first: true, ppTypes: ppTypes} %}
    {% endif %}

    <!-- Sortable container -->
    <div id="parts-{{ pagepartadmin.context }}" class="js-sortable-container sortable-container" data-scope="{% for type in ppTypes %}{{ type.class|replace({'\\':""})~' ' }}{% endfor %}">
        {% for id, pagepart in pagepartadmin.pagepartmap %}
            {% include '@KunstmaanPagePart/PagePartAdminTwigExtension/pagepart.html.twig' with { 'id': id, 'pagepartadmin': pagepartadmin, 'editmode': false, ppTypes: ppTypes} %}
        {% endfor %}
    </div>
</div>

{% if extended is defined and extended == true %}
    {% include '@KunstmaanPagePart/PagePartAdminTwigExtension/modal.html.twig' with { 'pagepartadmin': pagepartadmin, ppTypes: ppTypes } %}
{% endif %}

<div id="pageparts-deleted-container"></div>

